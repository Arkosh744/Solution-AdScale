@startuml target
!include <C4/C4_Container>
LAYOUT_TOP_DOWN()
title AdScale - целевая C4 Container через год
Person(advertiser, "Рекламодатель")
System_Ext(partner, "Рекламные партнеры", "OpenRTB")
System_Ext(payment, "Платежный шлюз")
System_Ext(cdn, "Объектное хранилище / CDN", "Рекламные материалы")
System_Boundary(adscale, "AdScale - основной регион; резерв показан отдельно") {
  Container(gateway, "API Gateway", "Envoy", "Доступ и маршруты")
  Container(dashboard, "Dashboard", "Web / Node.js", "Кабинет")
  Container(delivery, "Delivery", "Node.js / Go", "Материалы и HTML/JS")
  Container(bid, "Bidding", "Go", "Подбор, аукцион, адаптеры")
  ContainerDb(bidDb, "Bidding DB", "PostgreSQL", "Результаты, лимиты, резервы")
  Container(campaign, "Campaign", "Go", "Кампании и версии")
  ContainerDb(campaignDb, "Campaign DB", "PostgreSQL", "Настройки кампаний")
  Container(stats, "Statistics", "Go", "Устойчивый прием")
  ContainerDb(statsDb, "Statistics DB", "PostgreSQL", "Журнал и outbox")
  Container(finance, "Finance", "Go", "Балансы и списания")
  ContainerDb(financeDb, "Finance DB", "PostgreSQL", "Проводки и ключи операций")
  Container(analytics, "Analytics", "Go", "Отчеты и проекции")
  ContainerDb(analyticsDb, "Analytics DB", "ClickHouse", "События и агрегаты")
  ContainerDb(cache, "Кеш кампаний", "Redis", "Версии для Bidding")
  ContainerQueue(kafka, "События", "Kafka", "Раздельные топики и группы")
}
Rel(partner, gateway, "Ставки и уведомления", "HTTPS")
Rel(advertiser, gateway, "Кабинет", "HTTPS")
Rel(gateway, dashboard, "Управление", "HTTPS")
Rel(gateway, bid, "Ставки", "OpenRTB")
Rel(gateway, stats, "События", "HTTPS")
Rel(gateway, delivery, "Материалы", "HTTPS")
Rel(dashboard, campaign, "Кампании", "gRPC")
Rel(dashboard, finance, "Бюджеты", "gRPC")
Rel(dashboard, analytics, "Отчеты", "HTTPS")
Rel_D(bid, bidDb, "Одна TX", "SQL")
Rel_D(campaign, campaignDb, "Запись", "SQL")
Rel_D(stats, statsDb, "Прием до ACK", "SQL")
Rel_D(finance, financeDb, "Учет", "SQL")
Rel_D(analytics, analyticsDb, "Проекции", "Native")
Rel(bid, cache, "Загрузка в фоне", "RESP")
Rel(campaign, cache, "Снимки", "Фон")
Rel(campaign, kafka, "Версии", "Kafka")
Rel(kafka, bid, "Версии кампаний", "Consumer, фон")
Rel(finance, bid, "Лимиты и закрытие резерва", "gRPC, фон")
Rel(finance, payment, "Платежи", "HTTPS")
Rel(stats, kafka, "Публикация", "Kafka")
Rel(kafka, finance, "Финансовые события", "Consumer")
Rel(kafka, analytics, "Показы и клики", "Consumer")
Rel(delivery, cdn, "Публикация", "S3 API")
@enduml
